# ==============================================================================
# Full-Stack AI Portfolio Environment Configuration
# Copy this file to .env.local for local frontend development
# ==============================================================================

# FastAPI Backend Service URL (for SSR & server-side API routes)
# In local dev: http://localhost:8000
# In Docker Compose: http://backend:8000
# In Production: https://your-backend-api.onrender.com
FASTAPI_BACKEND_URL=http://localhost:8000

# Client-accessible Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Groq API Configuration (for AI Twin LPU inference)
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY=

# Preferred AI Model (Default: openai/gpt-oss-120b; Fallback: llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b
