# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://pranshu-portfolio.vercel.app"]

# MongoDB Configuration (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pranshu_portfolio_db

# Groq API Configuration (openai/gpt-oss-120b)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=llama-3.3-70b-versatile

# Admin / Security
ADMIN_API_KEY=dev_admin_secret_key_change_in_production
RATE_LIMIT_PER_MINUTE=60
